#!/bin/bash
exec >uperf-client-stderrout.txt
exec 2>&1

. /usr/bin/uperf-base || (echo "/usr/bin/uperf-base not found"; exit 1)

dump_runtime
validate_label
validate_sw_prereqs jq ss uperf getopt ip

# defaults
nthreads=1
protocol="tcp"
wsize=1024
rsize=1024
think=0.001 # time in seconds
duration=60
remotehost=""
control_port=""
data_port=""
test_type="stream"
uopts=""
cpu_pin=""
ipv="4"
namespace=""
numa_node=""
sched_priority=""
busy_poll_us=""
warmup="1"
worker_cpu=""
main_cpu=""
histogram=""
histogram_max=""
histogram_bucket=""

longopts="ipv:,test-type:,protocol:,rsize:,wsize:,nthreads:,remotehost:,duration:,"
longopts+="cpu-pin:,think:,passthru:,ifname:,"
longopts+="namespace:,numa-node:,sched-priority:,busy-poll-us:,"
longopts+="warmup:,worker-cpu:,main-cpu:,"
longopts+="histogram:,histogram-max:,histogram-bucket:"

opts=$(getopt -q -o "" --longoptions "$longopts" -n "getopt.sh" -- "$@");
if [ $? -ne 0 ]; then
    exit_error "Unrecognized option specified"
fi
eval set -- "$opts";
while true; do
    case "$1" in
        --ipv)
            shift;
            ipv="$1"
            echo "ipv=$ipv"
            shift
            ;;
        --cpu-pin)
            shift;
            cpu_pin=$1
            echo "cpu_pin=${cpu_pin}"
            shift;
            ;;
        --test-type)
            shift;
            test_type=$1
            echo "test_type=$test_type"
            if [ ! -e /tmp/xml-files/$test_type.xml ]; then
                exit_error "could not find /tmp/xml-files/$test_type.xml"
            fi
            shift;
            ;;
        --nthreads)
            shift;
            nthreads=$1
            echo "nthreads=$nthreads"
            shift;
            ;;
        --protocol)
            shift;
            protocol=$1
            echo "protocol=$protocol"
            shift
            ;;
        --rsize)
            shift;
            rsize=$1
            echo "rsize=$rsize"
            shift
            ;;
        --wsize)
            shift;
            wsize=$1
            echo "wsize=$wsize"
            shift
            ;;
        --think)
            shift;
            think=$1
            echo "think=$think"
            shift
            ;;
        --remotehost)
            shift;
            remotehost=$1
            echo "remotehost=$remotehost"
            shift
            ;;
        --duration)
            shift;
            duration=$1
            echo "duration=$duration"
            shift
            ;;
        --namespace)
            shift;
            namespace=$1
            echo "namespace=$namespace"
            shift
            ;;
        --numa-node)
            shift;
            numa_node=$1
            echo "numa_node=$numa_node"
            shift
            ;;
        --sched-priority)
            shift;
            sched_priority=$1
            echo "sched_priority=$sched_priority"
            shift
            ;;
        --busy-poll-us)
            shift;
            busy_poll_us=$1
            echo "busy_poll_us=$busy_poll_us"
            shift
            ;;
        --warmup)
            shift;
            warmup=$1
            echo "warmup=$warmup"
            shift
            ;;
        --worker-cpu)
            shift;
            worker_cpu=$1
            echo "worker_cpu=$worker_cpu"
            shift
            ;;
        --main-cpu)
            shift;
            main_cpu=$1
            echo "main_cpu=$main_cpu"
            shift
            ;;
        --histogram)
            shift;
            histogram=$1
            echo "histogram=$histogram"
            shift
            ;;
        --histogram-max)
            shift;
            histogram_max=$1
            echo "histogram_max=$histogram_max"
            shift
            ;;
        --histogram-bucket)
            shift;
            histogram_bucket=$1
            echo "histogram_bucket=$histogram_bucket"
            shift
            ;;
        --passthru)
            shift;
            pt_opts=$1
            echo "pt_opts=$pt_opts"
            shift
            ;;
        --ifname)
            shift;
            shift
            ;;
        --)
            shift;
            break
            ;;
        *)
            exit_error "Invalid option: $1"
    esac
done

cpu_pin_param=""
if echo "${cpu_pin}" | grep -q "^cpu:"; then
    cpu_pin_param=$(echo "${cpu_pin}" | awk -F: '{ print $2 }')
    cpu_pin=$(echo "${cpu_pin}" | awk -F: '{ print $1 }')
fi
case "${cpu_pin}" in
    ""|"cpu"|"numa")
	;;
    *)
	exit_error "unsupported cpu-pin value '${cpu_pin}'"
	;;
esac

if [ ! -e /tmp/xml-files/$test_type.xml ]; then
    exit_error "/tmp/xml-files/$test_type.xml was not found"
fi

# Unless the user specifies a specific remotehost argument, this must
# be sourced from the endpoint (which gets it from the client)
if [ -z "$remotehost" ]; then
    echo "--remotehost was not set via cmdline args, checking any messages from the endpoint"
    echo "These files exist in ./msgs/rx:"
    /bin/ls -l msgs/rx
    file="msgs/rx/svc"
    if [ ! -e "${file}" ]; then
        file="msgs/rx/endpoint-start-end:1"
    fi
    if [ ! -e "${file}" ]; then
        file="msgs/rx/server-start-end:1"
    fi
    if [ ! -e "${file}" ]; then
        file="msgs/rx/client-start:1"
    fi
    if [ -e "$file" ]; then
        echo "Found $file"
        ipaddr=`jq -r '.svc.ip' $file`
        if [ ! -z "$ipaddr" ]; then
            echo "Found server IP $ipaddr"
            remotehost=$ipaddr
        fi
        port=`jq -r '.svc.ports[0]' $file`
        if [ ! -z "$port" ]; then
            echo "Found server control port $port"
            control_port=$port
        fi
        port=`jq -r '.svc.ports[1]' $file`
        if [ ! -z "$port" ]; then
            echo "Found server data port $port"
            data_port=$port
        fi
    else
        echo "Did not find $file, so cannot get an IP from the server/endpoint"
    fi
fi

# Confirm we have a remotehost (server) and ports
if [ -z "$remotehost" ]; then
    exit_error "remotehost is not set"
fi

# Determine interface for NUMA detection (only if no namespace — with
# namespaces the route lookup happens inside the namespace)
if [ -z "$namespace" ]; then
    ifname=$(ip route get ${remotehost} | head -n 1 | awk -F" dev " '{ print $2 }' | awk -F" src " '{ print $1 }')
    if [ ! -e /sys/class/net/${ifname} ]; then
        exit_error "invalid interface '${ifname}' found"
    fi
else
    ifname=""
fi

ifname_numa_node=-1
ifname_numa_node_cpus=-1
if [ -n "$ifname" ] && [ -e /sys/class/net/${ifname}/device/numa_node ]; then
    ifname_numa_node=$(cat /sys/class/net/${ifname}/device/numa_node)
    if [ $ifname_numa_node == "-1" ] && [ "${cpu_pin}" == "numa" ]; then
        exit_error "PCIe has no NUMA locality, but cpu-pin is numa"
    fi
    ifname_numa_node_cpus=$(cat /sys/devices/system/node/node${ifname_numa_node}/cpulist)
elif [ "${cpu_pin}" == "numa" ]; then
    exit_error "cannot determine numa node for interface and cpu-pin is numa"
fi

# These ports should come from the endpoint, but if for some
# reason they don't the default port numbers are calculated
# in this way:
if [ -z "$control_port" ]; then
    let "control_port = 2 * $id"
    let "control_port = $control_port + 30000"
    echo "control_port was not set, using default of $control_port"
fi
if [ -z "$data_port" ]; then
    let "data_port = $control_port + 1"
    echo "data_port was not set, using default of $data_port"
fi
if [[ "$test_type" = "crr" ]]; then
    uopts="-tTfa"
fi

# Build connect options for XML (busy_poll)
connect_opts=""
if [ -n "$busy_poll_us" ] && [ "$busy_poll_us" -gt 0 ] 2>/dev/null; then
    connect_opts="busy_poll=$busy_poll_us"
fi

/bin/cp /tmp/xml-files/$test_type.xml test.xml

echo "ifname=${ifname}"
echo "ifname_numa_node=${ifname_numa_node}"
echo "remotehost=$remotehost"
echo "control_port=$control_port"
echo "data_port=$data_port"
echo "duration=$duration"
echo "wsize=$wsize"
echo "rsize=$rsize"
echo "think=$think"
echo "nthreads=$nthreads"
echo "protocol=$protocol"
echo "busy_poll_us=${busy_poll_us:-disabled}"
echo "warmup=$warmup"
echo "namespace=${namespace:-none}"
echo "numa_node=${numa_node:-not bound}"
echo "sched_priority=${sched_priority:-default}"
echo "worker_cpu=${worker_cpu:-not pinned}"
echo "main_cpu=${main_cpu:-not pinned}"
echo "histogram=${histogram:-disabled}"

# Build uperf flags from our fork's custom options
uperf_extra_opts=""
if [ -n "$sched_priority" ] && [ "$sched_priority" -gt 0 ] 2>/dev/null; then
    uperf_extra_opts+=" -F $sched_priority"
fi
if [ -n "$worker_cpu" ]; then
    uperf_extra_opts+=" -W $worker_cpu"
fi
if [ -n "$main_cpu" ]; then
    uperf_extra_opts+=" -M $main_cpu"
fi
if [ -n "$histogram" ]; then
    uperf_extra_opts+=" -H $histogram"
fi
if [ -n "$histogram_max" ] && [ "$histogram_max" -gt 0 ] 2>/dev/null; then
    uperf_extra_opts+=" -B $histogram_max"
fi
if [ -n "$histogram_bucket" ] && [ "$histogram_bucket" -gt 0 ] 2>/dev/null; then
    uperf_extra_opts+=" -b $histogram_bucket"
fi

# Build command prefix: numactl, nsenter
cmd_prefix=""
if [ -n "$numa_node" ]; then
    cmd_prefix="numactl --membind=$numa_node"
fi
if [ -n "$namespace" ]; then
    cmd_prefix="$cmd_prefix nsenter --net=/var/run/netns/$namespace"
fi

# CPU pinning via taskset (legacy cpu-pin param)
cpu_pin_cmd=""
case "${cpu_pin}" in
    "numa")
	cpu_pin_cmd="taskset --cpu-list ${ifname_numa_node_cpus}"
	;;
    "cpu")
	cpu_pin_cmd="taskset --cpu-list ${cpu_pin_param}"
	;;
esac

cmd="${cmd_prefix} ${cpu_pin_cmd} uperf -R -m test.xml -P $control_port $uopts${uperf_extra_opts}"

# strip ',' from the passthru options
passthru_opts=$(echo "$pt_opts" | sed 's/,/ /g')
options+=" $passthru_opts"
echo "passthru options: $options"
cmd+="$options"

echo "going to run: ${cmd}"
nthreads=$nthreads \
protocol=$protocol \
remotehost=$remotehost \
duration=$duration \
wsize=$wsize \
rsize=$rsize \
think=$think \
port=$data_port \
warmup=$warmup \
connect_opts="$connect_opts" \
${cmd} > uperf-client-result.txt 2>&1
uperf_rc=$?
uperf_errors=$(grep -i error uperf-client-result.txt | grep -v '^Hostname' | grep -v 'saying goodbye')
if [ ${uperf_rc} -gt 0 -o -n "${uperf_errors}" ]; then
    if [ $test_type == "crr" ]; then
        exit 0
    fi
    exit_error "$uperf_errors"
fi
